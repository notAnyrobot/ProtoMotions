FROM nvcr.io/nvidia/isaac-lab:2.3.0 AS isaaclab-base

FROM nvcr.io/nvidia/isaac-lab:2.3.0

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Fix apt GPG signature issues and install cmake
RUN rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && apt-get update \
    && apt-get install -y cmake \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Set working directory
WORKDIR /workspace/protomotions

# Copy protomotions requirements
COPY requirements_isaaclab.txt .

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TIMEOUT=600
ARG PIP_RETRIES=30

# Install remaining Python dependencies using IsaacLab's Python environment.
# Keep pip's download cache across Docker rebuilds so slow/failed downloads can resume.
RUN --mount=type=cache,target=/root/.cache/pip \
    /workspace/isaaclab/isaaclab.sh -p -m pip install \
    --timeout "${PIP_TIMEOUT}" \
    --retries "${PIP_RETRIES}" \
    --prefer-binary \
    --index-url "${PIP_INDEX_URL}" \
    -r requirements_isaaclab.txt

# Isaac Sim's Torch and pip vendored packaging modules symlink into this
# prebundle. A broad pip install can remove it while resolving dependencies.
COPY --from=isaaclab-base \
    /workspace/isaaclab/_isaac_sim/exts/omni.isaac.core_archive/pip_prebundle/packaging \
    /workspace/isaaclab/_isaac_sim/exts/omni.isaac.core_archive/pip_prebundle/packaging
COPY --from=isaaclab-base \
    /workspace/isaaclab/_isaac_sim/exts/omni.isaac.core_archive/pip_prebundle/packaging-23.0.dist-info \
    /workspace/isaaclab/_isaac_sim/exts/omni.isaac.core_archive/pip_prebundle/packaging-23.0.dist-info

# Don't copy or install protomotions here - it will be synced and installed from 
# the experiment folder in train_slurm.py. This ensures we always use fresh code
# and avoids conflicts between old Docker code and newly synced code.

# IsaacSim environment variables
ENV OMNI_KIT_ACCEPT_EULA=YES
ENV ACCEPT_EULA=Y

# Default command
CMD ["/bin/bash"]
