# FROM nvidia/cuda:12.4.0-devel-ubuntu22.04
FROM nvcr.io/nvidia/cuda:12.4.0-devel-ubuntu22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    git-lfs \
    vim \
    wget \
    curl \
    cmake \
    libglu1-mesa-dev \
    libgl1-mesa-dev \
    libosmesa6-dev \
    patchelf \
    ffmpeg \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv to system-wide location (not user-local, for SLURM compatibility)
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Set working directory
WORKDIR /workspace

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TIMEOUT=600
ARG PIP_RETRIES=30
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
ARG NEWTON_VERSION=1.0.0
ARG NEWTON_EXTRAS=sim

# Create virtual environment with pip seeded so python -m pip works.
RUN uv venv --python 3.10 --seed --index-url "${PIP_INDEX_URL}" .venv
ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH="/workspace/.venv/bin:$PATH"

RUN python -m pip --version

# Copy protomotions Newton requirements early so dependency pins can constrain Newton extras.
WORKDIR /workspace/protomotions
COPY requirements_newton.txt .
WORKDIR /workspace

# Install PyTorch with CUDA 12.4.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
    --timeout "${PIP_TIMEOUT}" \
    --retries "${PIP_RETRIES}" \
    --prefer-binary \
    --index-url "${TORCH_INDEX_URL}" \
    "torch>=2.2"

# Install the Newton version this repo is tested against. Default to headless simulation dependencies.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
    --timeout "${PIP_TIMEOUT}" \
    --retries "${PIP_RETRIES}" \
    --prefer-binary \
    --index-url "${PIP_INDEX_URL}" \
    -c /workspace/protomotions/requirements_newton.txt \
    "newton[${NEWTON_EXTRAS}]==${NEWTON_VERSION}"

WORKDIR /workspace/protomotions

# Install remaining Python dependencies (pins mujoco==3.5.0 to match Newton 1.0)
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
    --timeout "${PIP_TIMEOUT}" \
    --retries "${PIP_RETRIES}" \
    --prefer-binary \
    --index-url "${PIP_INDEX_URL}" \
    -r requirements_newton.txt

# Don't copy or install protomotions here - it will be synced and installed from 
# the experiment folder in train_slurm.py. This ensures we always use fresh code
# and avoids conflicts between old Docker code and newly synced code.

ENV MUJOCO_GL=osmesa

# Default command
CMD ["/bin/bash"]
