ARG BASE_IMAGE=protomotions-newton:cuda12.4-newton1.0.0
FROM ${BASE_IMAGE}

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TIMEOUT=600
ARG PIP_RETRIES=30
ARG JAXLS_COMMIT=5f766d3b09364a96d83497de2325a835d0e23dc4
ARG CUDNN_VERSION=9.8.0.87

ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH="/workspace/.venv/bin:$PATH"
ENV MUJOCO_GL=osmesa
ENV JAX_PLATFORMS=cuda,cpu
ENV XLA_PYTHON_CLIENT_PREALLOCATE=false
ENV PYTHONPATH=/workspace/pyroki/src:/workspace/protomotions:/workspace/protomotions/protomotions
ENV LD_LIBRARY_PATH="/workspace/.venv/lib/python3.10/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}"

WORKDIR /workspace/protomotions

RUN python -m pip --version

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
    --timeout "${PIP_TIMEOUT}" \
    --retries "${PIP_RETRIES}" \
    --prefer-binary \
    --index-url "${PIP_INDEX_URL}" \
    "jax==0.6.2" \
    "jaxlib==0.6.2" \
    "jax-cuda12-plugin==0.6.2" \
    "jax-cuda12-pjrt==0.6.2" \
    "nvidia-cudnn-cu12==${CUDNN_VERSION}" \
    "jax_dataclasses==1.6.3" \
    "jaxlie==1.5.0" \
    "jaxtyping==0.3.7" \
    "loguru==0.7.3" \
    "pyliblzfse==0.4.1" \
    "robot_descriptions==1.23.0" \
    "scipy==1.15.2" \
    "trimesh==4.11.5" \
    "tyro==1.0.11" \
    "viser==1.0.24" \
    "yourdfpy==0.0.60"

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
    --timeout "${PIP_TIMEOUT}" \
    --retries "${PIP_RETRIES}" \
    --prefer-binary \
    --index-url "${PIP_INDEX_URL}" \
    "hatchling==1.30.1" \
    "tomli==2.2.1"

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
    --timeout "${PIP_TIMEOUT}" \
    --retries "${PIP_RETRIES}" \
    --prefer-binary \
    --index-url "${PIP_INDEX_URL}" \
    --no-build-isolation \
    "jaxls @ https://github.com/brentyi/jaxls/archive/${JAXLS_COMMIT}.tar.gz"

CMD ["/bin/bash"]
